# ==========================================
# Reflex Environment Configuration Template
# Copy this file to .env and customize values
# ==========================================

# ── Database (PostgreSQL) ─────────────────
SERVERPOD_DATABASE_HOST=localhost
SERVERPOD_DATABASE_PORT=8090
SERVERPOD_DATABASE_NAME=reflex
SERVERPOD_DATABASE_USER=postgres
SERVERPOD_DATABASE_PASSWORD=your_postgres_password_here

# ── Redis Broker ──────────────────────────
SERVERPOD_REDIS_HOST=localhost
SERVERPOD_REDIS_PORT=6379
SERVERPOD_REDIS_PASSWORD=your_redis_password_here

# ── Serverpod Core Secrets ────────────────
SERVERPOD_SERVICE_SECRET=your_service_secret_here
SERVERPOD_PASSWORD_jwtHmacSha512PrivateKey=your_jwt_hmac_key_here
SERVERPOD_PASSWORD_jwtRefreshTokenHashPepper=your_jwt_refresh_pepper_here
SERVERPOD_PASSWORD_emailSecretHashPepper=your_email_pepper_here

# ── Google OAuth 2.0 Credentials ──────────
# Flutter Web / Mobile Client ID:
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# Downloaded Web Client JSON from Google Cloud Console:
SERVERPOD_PASSWORD_googleClientSecret='{"web":{"client_id":"YOUR_WEB_CLIENT_ID.apps.googleusercontent.com","client_secret":"YOUR_CLIENT_SECRET","redirect_uris":["http://localhost:8082/auth/google/callback"]}}'

# ── Sentry Error Monitoring ───────────────
SENTRY_DSN=

# ── Flutter Client Configuration ──────────
SERVER_URL=http://localhost:8080/
