{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker_up",
      "type": "shell",
      "command": "docker compose up -d postgres redis",
      "options": {
        "cwd": "${workspaceFolder}/reflex_server"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "serverpod_start",
      "type": "shell",
      "command": "serverpod",
      "args": ["start"],
      "options": {
        "cwd": "${workspaceFolder}/reflex_server",
        "env": {
          "PATH": "${workspaceFolder}/.fvm/flutter_sdk/bin:${env:HOME}/.pub-cache/bin:${env:PATH}",
          "SERVERPOD_PASSWORD_database": "YPMVf_v_oijIRvvFDpat6nFOF3tcQ0iw",
          "SERVERPOD_LAUNCHED_FROM_IDE": "true"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "serverpod",
        "pattern": [
          {
            "regexp": "^(SERVERPOD_NEVER_MATCH):(\\d+):(.+)$",
            "file": 1,
            "line": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "."
        }
      }
    }
  ]
}
