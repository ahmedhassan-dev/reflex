{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Reflex Server",
      "type": "dart",
      "request": "launch",
      "program": "bin/main.dart",
      "args": [
        "--apply-migrations"
      ],
      "cwd": "${workspaceFolder}/reflex_server",
      "preLaunchTask": "docker_up",
      "env": {
        "SERVERPOD_PASSWORD_database": "YPMVf_v_oijIRvvFDpat6nFOF3tcQ0iw"
      }
    },
    {
      "name": "Reflex Flutter",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/reflex_flutter",
      "args": [
        "-d",
        "chrome",
        "--web-port=8085",
        "--dart-define-from-file=${workspaceFolder}/.env"
      ]
    },
    {
      "name": "reflex_flutter (attach to CLI)",
      "type": "dart",
      "request": "attach",
      "vmServiceInfoFile": "${workspaceFolder}/reflex_server/.dart_tool/serverpod/flutter-vm-service-info-reflex.json",
      "preLaunchTask": "serverpod_start",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "reflex_server (attach to CLI)",
      "type": "dart",
      "request": "attach",
      "vmServiceInfoFile": "${workspaceFolder}/reflex_server/.dart_tool/serverpod/vm-service-info.json",
      "preLaunchTask": "serverpod_start",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "compounds": [
    {
      "name": "Reflex (Server + Flutter App)",
      "configurations": [
        "Reflex Server",
        "Reflex Flutter"
      ],
      "stopAll": true,
      "presentation": {
        "order": 1
      }
    },
    {
      "name": "Reflex (Serverpod CLI + Attach)",
      "configurations": [
        "reflex_server (attach to CLI)",
        "reflex_flutter (attach to CLI)"
      ],
      "stopAll": true,
      "presentation": {
        "order": 2
      }
    }
  ]
}